APP_NAME=Buddy Duckling
DEBUG=false

DATABASE_URL=postgresql+asyncpg://buddy:buddy@127.0.0.1:5433/buddy_duckling
TEST_DATABASE_URL=postgresql+asyncpg://buddy:buddy@127.0.0.1:5433/buddy_duckling_test

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to false to run the API without the hourly streak check
SCHEDULER_ENABLED=true
